{
  "_about": "Evolution: when a pet changes form and which form it becomes. Explained in data/README.md and the Pet Evolution Guide PDF. Form ids are the folder names for form art: pets/<pet id>/forms/<form id>/ (care frames) and .../<form id>/battle/ (battle frames).",

  "stages": {"child": 10, "adult": 25, "final": 45},
  "_stages": "Level at which each stage starts. Before child the pet is a baby (after hatching). Final also needs the Trial battle won (final_needs_trial).",
  "final_needs_trial": true,

  "branch_rule": {"pure_lead": 8, "hybrid_within": 8, "harmony_within": 6},
  "_branch_rule": "Uses the shares of STR, INT and AGI (percent of the three added up). Harmony: all three within harmony_within points. Pure: the top stat leads the second by at least pure_lead. Hybrid (Final only): the top two are within hybrid_within. An Adult that is neither Harmony nor clearly pure takes its top stat.",

  "stage_bonus": {"baby": 0, "child": 2, "adult": 5, "final": 10},
  "_stage_bonus": "Flat points added to every stat in battle at each stage (stats themselves never reset).",

  "preview_levels_before": 3,
  "_preview_levels_before": "From this many levels before Adult / Final, the app can show which form the pet is heading for.",

